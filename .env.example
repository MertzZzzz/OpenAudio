# Copy to .env and adjust. Used by docker-compose.yml.
POSTGRES_USER=openaudio
POSTGRES_PASSWORD=openaudio
POSTGRES_DB=openaudio
POSTGRES_PORT=5432

MINIO_ROOT_USER=openaudio
MINIO_ROOT_PASSWORD=openaudio-secret
MINIO_BUCKET=openaudio-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

WEB_PORT=5173
API_PORT=8080

# --- Address -------------------------------------------------------------
# Base domain of the deployment (host[:port], no scheme), e.g. openaudio.example.com.
# WEB_URL and PUBLIC_URL default to <BASE_SCHEME>://<BASE_DOMAIN>; CORS, OAuth redirect URIs,
# links in emails and the mail sender follow. Empty → http://localhost:5173.
BASE_DOMAIN=
# https by default; http for localhost / 127.x.
BASE_SCHEME=
# Explicit overrides (rarely needed): where the SPA lives / where browsers reach the API.
WEB_URL=
PUBLIC_URL=
# MinIO as seen by browsers (presigned downloads), e.g. https://s3.openaudio.example.com
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- API / auth ---------------------------------------------------------
# At least 32 bytes. Leave empty in dev to generate one per start (sessions reset on restart).
JWT_SECRET=
# Default administrator, created on API start (email pre-verified). .env is the source of truth:
# changing ADMIN_PASSWORD here resets the password (and signs the admin out) on next start.
# Both empty → no default admin. The example password is refused when APP_ENV=production.
ADMIN_EMAIL=admin@openaudio.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Admin
# Extra comma-separated emails that become admin when they sign up.
ADMIN_EMAILS=

# Page users land on after signing in when they did not come from a protected page (e.g. /library).
AUTH_REDIRECT_PATH=/
# SPA page OAuth sign-in finishes at. Empty → <WEB_URL>/auth/callback.
AUTH_CALLBACK_URL=

# Google: https://console.cloud.google.com/apis/credentials (OAuth client "Web application")
#   Authorized redirect URI: <PUBLIC_URL>/api/v1/auth/oauth/google/callback
#   (http://localhost:5173/api/v1/auth/oauth/google/callback by default; the API logs the exact URI on start)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications → OAuth2
#   Redirect: <PUBLIC_URL>/api/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Without SMTP, verification / password-reset emails are printed to `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Empty → OpenAudio <no-reply@BASE_DOMAIN>
SMTP_FROM=

# --- Publishing ----------------------------------------------------------
# Upload part size in bytes (≥ 5 MiB, S3 minimum), max blob size, presigned download URL lifetime.
UPLOAD_PART_SIZE=8388608
MAX_BLOB_SIZE=2147483648
DOWNLOAD_URL_TTL=10m
