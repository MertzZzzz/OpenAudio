# Copy to .env and adjust. Used by docker-compose.yml.
POSTGRES_USER=openaudio
POSTGRES_PASSWORD=openaudio
POSTGRES_DB=openaudio
POSTGRES_PORT=5432

MINIO_ROOT_USER=openaudio
MINIO_ROOT_PASSWORD=openaudio-secret
MINIO_BUCKET=openaudio-dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

WEB_PORT=5173
API_PORT=8080

# --- API / auth ---------------------------------------------------------
# At least 32 bytes. Leave empty in dev to generate one per start (sessions reset on restart).
JWT_SECRET=
# Comma-separated emails that become admin on sign-up.
ADMIN_EMAILS=

# Google: https://console.cloud.google.com/apis/credentials (OAuth client "Web application")
#   Authorized redirect URI: http://localhost:5173/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications → OAuth2
#   Redirect: http://localhost:5173/api/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Without SMTP, verification / password-reset emails are printed to `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=OpenAudio <no-reply@openaudio.local>

# --- Publishing ----------------------------------------------------------
# Upload part size in bytes (≥ 5 MiB, S3 minimum), max blob size, presigned download URL lifetime.
UPLOAD_PART_SIZE=8388608
MAX_BLOB_SIZE=2147483648
DOWNLOAD_URL_TTL=10m
