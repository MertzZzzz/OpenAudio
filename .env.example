# Copy to .env and adjust. Used by docker-compose.yml.
POSTGRES_USER=openaudio
POSTGRES_PASSWORD=openaudio
POSTGRES_DB=openaudio
POSTGRES_PORT=5432

WEB_PORT=5173
API_PORT=8080

# --- Address -------------------------------------------------------------
# Base domain of the deployment (host[:port], no scheme), e.g. openaudio.example.com.
# WEB_URL and PUBLIC_URL default to <BASE_SCHEME>://<BASE_DOMAIN>; CORS, OAuth redirect URIs,
# links in emails and the mail sender follow. Empty → http://localhost:5173.
BASE_DOMAIN=
# https by default; http for localhost / 127.x.
BASE_SCHEME=
# Explicit overrides (rarely needed): where the SPA lives / where browsers reach the API.
WEB_URL=
PUBLIC_URL=

# --- Object storage (S3) ---------------------------------------------------
# Two setups:
#
# A) Local Silo (default). docker compose starts PGSTY Silo, an S3-compatible MinIO fork, plus a
#    one-shot container that creates the bucket. Console: http://localhost:9001.
COMPOSE_PROFILES=local-s3
SILO_ROOT_USER=openaudio
SILO_ROOT_PASSWORD=openaudio-secret
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001
# SILO_IMAGE=pgsty/silo:RELEASE.2026-11-12T00-00-00Z
#
# B) External S3 (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, your own MinIO/Silo, ...):
#    set COMPOSE_PROFILES= (empty, so Silo does not start) and fill in the S3_* values below.
#    Examples:
#      AWS S3:  S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com  S3_REGION=eu-central-1  S3_FORCE_PATH_STYLE=false
#      R2:      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#      B2:      S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com  S3_REGION=us-west-004
#    The bucket must not be public: downloads use short-lived presigned URLs.
#
# Empty values fall back to the local Silo (endpoint http://silo:9000, the SILO_ROOT_* credentials).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=openaudio-dev
S3_REGION=us-east-1
# Address browsers use for presigned downloads. Empty: S3_ENDPOINT, or http://localhost:9000
# for the local Silo. Set it when browsers reach storage elsewhere (a CDN, https://s3.example.com).
S3_PUBLIC_ENDPOINT=
# true: https://host/bucket (Silo/MinIO and most S3-compatible services);
# false: https://bucket.host (AWS S3).
S3_FORCE_PATH_STYLE=true
# Create the bucket on API start when it is missing. Set false when the credentials may only
# read and write objects (typical for external S3; create the bucket in its console instead).
S3_CREATE_BUCKET=true

# --- API / auth ---------------------------------------------------------
# At least 32 bytes. Leave empty in dev to generate one per start (sessions reset on restart).
JWT_SECRET=
# Default administrator, created on API start (email pre-verified). .env is the source of truth:
# changing ADMIN_PASSWORD here resets the password (and signs the admin out) on next start.
# Both empty → no default admin. The example password is refused when APP_ENV=production.
ADMIN_EMAIL=admin@openaudio.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=Admin
# Extra comma-separated emails that become admin when they sign up.
ADMIN_EMAILS=

# Page users land on after signing in when they did not come from a protected page (e.g. /library).
AUTH_REDIRECT_PATH=/
# SPA page OAuth sign-in finishes at. Empty → <WEB_URL>/auth/callback.
AUTH_CALLBACK_URL=

# Google: https://console.cloud.google.com/apis/credentials (OAuth client "Web application")
#   Authorized redirect URI: <PUBLIC_URL>/api/v1/auth/oauth/google/callback
#   (http://localhost:5173/api/v1/auth/oauth/google/callback by default; the API logs the exact URI on start)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications → OAuth2
#   Redirect: <PUBLIC_URL>/api/v1/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Without SMTP, verification / password-reset emails are printed to `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Empty → OpenAudio <no-reply@BASE_DOMAIN>
SMTP_FROM=

# --- Publishing ----------------------------------------------------------
# Upload part size in bytes (≥ 5 MiB, S3 minimum), max blob size, presigned download URL lifetime.
UPLOAD_PART_SIZE=8388608
MAX_BLOB_SIZE=2147483648
DOWNLOAD_URL_TTL=10m
